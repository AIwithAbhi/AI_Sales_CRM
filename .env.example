# Firecrawl API Key - Get from https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# NVIDIA API Key - Get from https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Airtable Credentials - Get from https://airtable.com/create/tokens
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# Airtable Table Name (default: Leads)
AIRTABLE_TABLE_NAME=newlead

# Resend SMTP (recommended) — https://resend.com/docs/send-with-smtp
# EMAIL_PASSWORD must be your real Resend API key (re_...), not the placeholder below.
# Until you verify a domain, Resend only delivers to RESEND_ACCOUNT_EMAIL
# (the address you used to sign up at resend.com) — put that same address in the UI.
EMAIL_SENDER=onboarding@resend.dev
EMAIL_PASSWORD=re_your_resend_api_key
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
RESEND_ACCOUNT_EMAIL=your_resend_signup@gmail.com
# Set true after domain verify at resend.com/domains (allows any recipient)
RESEND_DOMAIN_VERIFIED=false
ALERT_EXTRA_RECIPIENTS=

# Gmail alternative: omit EMAIL_SMTP_USER (login uses EMAIL_SENDER + App Password)
# EMAIL_SENDER=your@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587

# Sent-alert deduplication store (created automatically)
ALERTS_DB_PATH=data/alerts_sent.json

# Funnel stage log (SQLite) — one row per company per run
# FUNNEL_DB_PATH=data/funnel.db

# --- Regulatory → sales email drafts ---
# Sender identity used in personalized outreach (never hard-code in code)
SALES_PERSON_NAME=Abhishek Hingu
SALES_COMPANY_NAME=
SALES_COMPANY_WEBSITE=
# Optional separate Airtable table for regulatory opportunities (defaults to AIRTABLE_TABLE_NAME)
# AIRTABLE_REGULATORY_TABLE_NAME=RegulatoryOpportunities
