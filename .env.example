# Firecrawl API Key - Get from https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# NVIDIA API Key - Get from https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here

# Airtable Credentials - Get from https://airtable.com/create/tokens
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_base_id_here

# Airtable Table Name (default: Leads)
AIRTABLE_TABLE_NAME=newlead

# Resend SMTP (recommended) — https://resend.com/docs/send-with-smtp
EMAIL_SENDER=onboarding@resend.dev
EMAIL_PASSWORD=re_your_resend_api_key
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=resend
RESEND_ACCOUNT_EMAIL=your_resend_signup@gmail.com
# Set true after domain verify at resend.com/domains (allows any recipient)
RESEND_DOMAIN_VERIFIED=false
ALERT_EXTRA_RECIPIENTS=other@gmail.com

# Gmail alternative: omit EMAIL_SMTP_USER (login uses EMAIL_SENDER + App Password)
# EMAIL_SENDER=your@gmail.com
# EMAIL_PASSWORD=your_gmail_app_password
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587

# Sent-alert deduplication store (created automatically)
ALERTS_DB_PATH=data/alerts_sent.json

# --- Cold email drafts (edit config/cold_email.json OR override here) ---
# Config file path (JSON). Change subject_format, product_name, cta, body_template there.
COLD_EMAIL_CONFIG_PATH=config/cold_email.json
# Optional env overrides (win over JSON when set):
COLD_EMAIL_PRODUCT_NAME=Your Product
COLD_EMAIL_SENDER_NAME=Your Name
COLD_EMAIL_DEFAULT_FIRST_NAME=there
# Subject uses {company_name} and {signal} placeholders
COLD_EMAIL_SUBJECT_FORMAT={company_name} + {signal}
# CTA uses {buying_signal}, {company_name}, {industry}, etc.
COLD_EMAIL_CTA=Quick question: Is {buying_signal} on your roadmap this year?
COLD_EMAIL_IMPACT_PCT=30
COLD_EMAIL_PAIN_POINT_DEFAULT=operational friction
COLD_EMAIL_CSV_PATH=data/cold_emails.csv
COLD_EMAIL_STATUS=Draft
COLD_EMAIL_SEND_DELAY_HOURS=0
COLD_EMAIL_MIN_LEAD_SCORE=1
